<base:UserControlBase
    x:Class="MergePDF.View.PDFCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:MergePDF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MergePDF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <system:Double x:Key="ButtonSize">40</system:Double>
    </UserControl.Resources>

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="{StaticResource ResourceKey=ButtonSize}"
                    Height="{StaticResource ResourceKey=ButtonSize}"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="{StaticResource ResourceKey=ButtonSize}"
                    Height="{StaticResource ResourceKey=ButtonSize}"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=OpenFolderCommand}"
                    CommandParameter="{x:Static core:CommandButtons.OpenFolder}"
                    ToolTip="Ordner mit PDF Dateien öffnen">
                    <Image Source="{StaticResource ResourceKey=IconOffice_Folder_open_64}" Stretch="Uniform" />
                </Button>

                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center">
                    <Run Text="Anzahl Images" />
                    <Run Text=":" />
                    <Run Text="{Binding Path=ImageInfo, FallbackValue=0}" />
                </TextBlock>

                <Border
                    Width="1"
                    Margin="5,0,0,0"
                    Background="Gray" />

                <base:ChooseBox
                    Title="Merge PDF speichern unter ..."
                    Width="300"
                    Height="25"
                    Margin="5,0,0,0"
                    ChooseBoxType="SaveFile"
                    DefaultExtension="Images|*.png"
                    ExtensionFilter="Images|*.png"
                    Text="{Binding Path=CreateFilename, FallbackValue=~CreateFilename}" />

                <Button
                    Width="{StaticResource ResourceKey=ButtonSize}"
                    Height="{StaticResource ResourceKey=ButtonSize}"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=SavePDFCommand}"
                    CommandParameter="{x:Static core:CommandButtons.SavePDF}"
                    ToolTip="PDF speichern">
                    <Image Source="{StaticResource ResourceKey=IconOffice_Save_as_PDF_64}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            ColumnDefinitions="Auto,*"
            RowDefinitions="*">
            <TextBlock />
        </Grid>

        <!--#endregion Hauptmenübar-->
    </Grid>
</base:UserControlBase>
